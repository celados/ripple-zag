{
  "name": "@celados/ripple-zag",
  "version": "0.3.0",
  "description": "Zag JS adapter for RippleJS",
  "keywords": [
    "js",
    "machine",
    "xstate",
    "statechart",
    "component",
    "zag-js",
    "RippleJS",
    "ripple"
  ],
  "author": "Abraham Aremu <anubra266@gmail.com>",
  "contributors": [
    "ethan-huo"
  ],
  "homepage": "https://github.com/celados/ripple-zag#readme",
  "license": "MIT",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/celados/ripple-zag.git"
  },
  "sideEffects": false,
  "bugs": {
    "url": "https://github.com/celados/ripple-zag/issues"
  },
  "scripts": {
    "build": "tsup",
    "test": "bun run build && NODE_OPTIONS='--conditions=browser' vitest",
    "typecheck": "bun run build && tsc --noEmit"
  },
  "publishConfig": {
    "registry": "https://npm.celados.com",
    "access": "public"
  },
  "dependencies": {
    "@zag-js/core": "^1.43.0",
    "@zag-js/types": "^1.43.0",
    "@zag-js/utils": "^1.43.0"
  },
  "peerDependencies": {
    "ripple": "^0.3.118"
  },
  "devDependencies": {
    "@ripple-ts/vite-plugin": "^0.3.118",
    "@types/node": "^24.10.2",
    "jsdom": "^28.1.0",
    "tsup": "^8.4.0",
    "typescript": "^5.9.2",
    "vitest": "^4.0.18"
  }
}
